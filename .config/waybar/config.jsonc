[
  {
    "output": "DP-1",
    "layer": "top",
    "position": "top",
    "mode": "dock",
    "margin-top": 10,
    "margin-bottom": 0,
    "reload_style_on_change": true,

    // Load Modules
    "include": ["~/.config/waybar/modules.json"],

    "modules-left": [ "custom/appmenu", "hyprland/window" ],
    "modules-center": [ "hyprland/workspaces" ],
    "modules-right": [ "tray", "custom/updates", "pulseaudio", "network", "group/hardware", "group/glock", "custom/exit" ],
  },

  {
    "output": "HDMI-A-1",
    "layer": "top",
    "position": "top",
    "mode": "dock",
    "margin-top": 10,
    "margin-bottom": 0,
    "reload_style_on_change": true,

    // Load Modules
    "include": ["~/.config/waybar/modules.json"],

    "modules-left": [ "custom/appmenu", "hyprland/window" ],
    "modules-center": [ "hyprland/workspaces" ],
    "modules-right": [ "tray", "group/glock", "custom/exit" ],
  }
]
