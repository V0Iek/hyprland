{
  //  _          __ _
  // | |    ___ / _| |_
  // | |   / _ \ |_| __|
  // | |__|  __/  _| |_
  // |_____\___|_|  \__|

  "custom/appmenu": {
    "format": "Apps",
    "on-click": "killall rofi || rofi -show drun -theme ~/.config/rofi/global/rofi.rasi",
    "tooltip": false
  },

  "hyprland/window": {
    "rewrite": {
      "(.*) - Brave": "Brave",
      "(.*) - Discord": "Discord"
    },
    "separate-outputs": true
  },

  //   ____           _
  //  / ___|___ _ __ | |_ ___ _ __
  // | |   / _ \ '_ \| __/ _ \ '__|
  // | |__|  __/ | | | ||  __/ |
  //  \____\___|_| |_|\__\___|_|

  "hyprland/workspaces": {
    "all-outputs": false,
    "on-click": "activate"
  },

  //  ____  _       _     _
  // |  _ \(_) __ _| |__ | |_
  // | |_) | |/ _` | '_ \| __|
  // |  _ <| | (_| | | | | |_
  // |_| \_\_|\__, |_| |_|\__|
  //          |___/

  "custom/updates": {
    "format": "   {}",
    "interval": 3600,
    "exec": "checkupdates | wc -l",
    "exec-if": "exit 0",
    "on-click": "alacritty -e 'yay -Syu'",
    "signal": 8,
    "tooltip": false
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-bluetooth": "{icon}  {volume}%",
    "format-muted": "󰝟 ",
    "format-icons": {
      "headphone": " ",
      "hands-free": " ",
      "headset": " ",
      "phone": " ",
      "portable": " ",
      "car": " ",
      "default": ["󰕿 ", "󰖀 ", "󰕾 "]
    },
    "scroll-step": 1,
    "on-click": "pavucontrol",
    "ignored-sinks": ["Easy Effects Sink"]
  },

  "pulseaudio/slider": {
    "min": 0,
    "max": 100,
    "orientation": "horizontal"
  },

  "group/pulseaudio": {
    "orientation": "horizontal",
    "modules": ["pulseaudio", "pulseaudio/slider"]
  },

  "network": {
    "format": "{ifname}",
    "format-wifi": "   {signalStrength}%",
    "format-ethernet": "  {ifname}",
    "format-disconnected": "Disconnected",
    "tooltip-format": " {ifname} via {gwaddri}",
    "tooltip-format-wifi": "  {ifname} @ {essid}\nIP: {ipaddr}\nStrength: {signalStrength}%\nFreq: {frequency}MHz\nUp: {bandwidthUpBits} Down: {bandwidthDownBits}",
    "tooltip-format-ethernet": " {ifname}\nIP: {ipaddr}\n up: {bandwidthUpBits} down: {bandwidthDownBits}",
    "tooltip-format-disconnected": "Disconnected",
    "max-length": 50
  },

  // Group Hardware
  "custom/system": {
    "format": " ",
    "tooltip": false
  },

  "cpu": {
    "format": "/   {usage}% ",
    "on-click": "alacritty -e htop"
  },

  "memory": {
    "format": "/  {}% ",
    "on-click": "alacritty -e htop"
  },

  "disk": {
    "interval": 30,
    "format": "󰋊  {percentage_used}% ",
    "path": "/",
    "on-click": "alacritty -e htop"
  },

  "group/hardware": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 300,
      "children-class": "not-memory",
      "transition-left-to-right": false
    },
    "modules": ["custom/system", "disk", "cpu", "memory"]
  },

  "tray": {
    "icon-size": 20,
    "spacing": 10
  },

  "clock": {
    "interval": 60,
    "tooltip": true,
    "format": "{:%Od %b %H:%M}",
    "tooltip-format": "{:%Y-%m-%d}"
  },

  "custom/exit": {
    //"format": " ",
    "format": "󰐥 ",
    "on-click": "wlogout",
    "tooltip": false
  }
}
